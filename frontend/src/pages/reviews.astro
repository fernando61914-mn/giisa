---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  title="Opiniones de clientes"
  description="Las opiniones verificadas de clientes de GIISA se publicarán aquí cuando estén disponibles."
  robots="noindex, nofollow"
>
  <Header slot="header" />

  <Banner title="Opiniones de clientes" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-heading text-h2 font-bold text-text">
          Opiniones verificadas
        </h2>
        <p class="mt-4 text-text-muted leading-relaxed">
          Publicaremos reseñas de clientes cuando contemos con su autorización.
          Mientras tanto, puedes conocer nuestros servicios y proyectos.
        </p>
        <a
          href="/#proyectos"
          class="mt-6 inline-flex min-h-11 items-center rounded-md border-2 border-primary px-6 py-3 font-bold text-primary transition-colors hover:bg-primary hover:text-primary-fg"
        >
          Ver proyectos
        </a>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
