---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import About from "../components/About.astro";
import Statistics from "../components/Statistics.astro";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import CTA from "../components/CTA.astro";

import * as homeData from "../data/home";
import { brand } from "../config/brand";
import { client } from "../data/client";

const schema = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: brand.name,
  alternateName: "GIISA",
  description: brand.description,
  url: brand.url,
  telephone: client.phone,
  email: client.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ciudad de México",
    addressRegion: "CDMX",
    addressCountry: "MX",
  },
  areaServed: {
    "@type": "Country",
    name: "México",
  },
  serviceType: [
    "Construcción civil",
    "Supervisión de obras",
    "Infraestructura vial e hidráulica",
    "Naves industriales",
  ],
  knowsAbout: [
    "Construcción",
    "Ingeniería civil",
    "Supervisión de obra",
    "Infraestructura",
  ],
  logo: `${brand.url}/logo.png`,
  image: `${brand.url}/og-image.svg`,
};
---

<BaseLayout
  title={`${homeData.hero.titulo} — GIISA`}
  description={homeData.nosotros.encabezado?.descripcion}
  schema={schema}
>
  <Header slot="header" />

  <main>
    <Hero data={homeData.hero} />
    <TrustBar items={homeData.barraConfianza} />
    <About data={homeData.nosotros} />
    <Statistics data={homeData.estadisticas} />
    <Services
      encabezado={homeData.encabezadoServicios}
      servicios={homeData.servicios}
      boton={homeData.botonServicios}
    />
    <Projects
      encabezado={homeData.encabezadoProyectos}
      proyectos={homeData.proyectos}
      boton={homeData.botonProyectos}
    />
    <CTA data={homeData.cta} />
  </main>

  <Footer slot="footer" />
</BaseLayout>
