---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import * as homeData from '../data/home';

const services = homeData.servicios;
const serviceIcons: Record<string, string> = {
  'obra-civil': 'construccion',
  'servicios-electricos': 'electrico',
  edificacion: 'edificio',
  'naves-industriales': 'construccion',
  'supervision-de-obra': 'escudo',
  'mantenimiento-integral': 'herramienta',
  'soluciones-digitales': 'codigo',
};
---

<BaseLayout
  title="Servicios"
  description="Conoce los servicios de GIISA en obra civil, instalaciones eléctricas, edificación, supervisión, mantenimiento y soluciones digitales."
>
  <Header slot="header" />

  <Banner title="Servicios" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold text-text">
          {homeData.encabezadoServicios.titulo}
        </h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          {homeData.encabezadoServicios.descripcion}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {services.map((service) => (
          <div class="flex gap-5 rounded-lg border border-border bg-background p-6 shadow-sm">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <Icon name={service.icono ?? serviceIcons[service.slug] ?? "default"} class="size-6" />
            </div>
            <div>
              <h3 class="font-heading text-h3 font-semibold text-text">
                {service.nombre}
              </h3>
              <p class="mt-2 text-text-muted leading-relaxed">
                {service.descripcionCorta}
              </p>
              {service.url && (
                <a
                  href={service.url}
                  class="mt-4 inline-flex min-h-10 items-center font-semibold text-primary hover:text-accent"
                >
                  Ver servicios eléctricos
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA data={homeData.cta} />

  <Footer slot="footer" />
</BaseLayout>
