---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import * as homeData from '../data/home';
import { aboutImages } from '../config/images';
---

<BaseLayout
  title="Sobre nosotros"
  description="GIISA es una empresa mexicana de ingeniería y construcción especializada en infraestructura, edificación, supervisión y obra industrial."
>
  <Header slot="header" />

  <Banner title="Sobre GIISA" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">
          Grupo de Infraestructura Integral
        </span>
        <h2 class="font-heading text-h2 font-bold leading-tight text-text">
          {homeData.nosotros.encabezado?.titulo}
        </h2>
        <p class="text-text-muted leading-relaxed">
          {homeData.nosotros.encabezado?.descripcion}
        </p>
      </div>
      {
        aboutImages.principal && (
          <div class="overflow-hidden rounded-xl shadow-lg">
            <Image
              src={aboutImages.principal}
              alt="Equipo de GIISA en una obra"
              width={800}
              height={600}
              loading="lazy"
              widths={[800, 1400]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              class="size-full object-cover"
            />
          </div>
        )
      }
    </div>
  </section>

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="font-heading text-h2 font-bold text-text">
          Áreas de especialidad
        </h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Soluciones para proyectos de infraestructura, construcción y operación.
        </p>
      </div>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {homeData.servicios.map((servicio) => (
          <li class="rounded-lg border border-border bg-background p-6">
            <h3 class="font-heading text-h3 font-semibold text-text">
              {servicio.nombre}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              {servicio.descripcionCorta}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTA data={homeData.cta} />

  <Footer slot="footer" />
</BaseLayout>
