---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
import Icon from "../components/Icon.astro";
import { brand } from "../config/brand";
import { cta } from "../data/home";

const areas = [
  {
    title: "Ingeniería, proyectos y asesoría",
    icon: "codigo",
    description:
      "Análisis y diseño para planear instalaciones eléctricas seguras, confiables y adecuadas a cada proyecto.",
    services: [
      "Ingeniería y diseño de instalaciones eléctricas",
      "Memorias de cálculo y estudios de corto circuito",
      "Coordinación de protecciones eléctricas y alcance de alimentadores",
      "Clasificación de áreas peligrosas",
      "Sistemas de puesta a tierra y protección contra descargas atmosféricas",
      "Estudios de ahorro, eficiencia, calidad de energía y contenido de armónicos",
      "Dirección responsable de obra, cuando corresponda al alcance y acreditaciones aplicables",
    ],
  },
  {
    title: "Construcción de instalaciones",
    icon: "electrico",
    description:
      "Ejecución de instalaciones eléctricas de baja, media y alta tensión para entornos industriales, comerciales y residenciales.",
    services: [
      "Subestaciones y transformadores",
      "Plantas de emergencia",
      "Líneas aéreas y alimentadores eléctricos",
      "Sistemas de puesta a tierra y pararrayos",
      "Iluminación interior y exterior, residencial e industrial",
    ],
  },
  {
    title: "Pruebas y puesta en servicio",
    icon: "escudo",
    description:
      "Pruebas y revisiones para conocer las condiciones de operación de las instalaciones y apoyar su puesta en servicio.",
    services: [
      "Pruebas a instalaciones de baja, media y alta tensión",
      "Pruebas VLF, según el tipo de instalación y el alcance del proyecto",
      "Revisión de resultados y recomendaciones técnicas",
    ],
  },
  {
    title: "Mantenimiento y continuidad operativa",
    icon: "herramienta",
    description:
      "Mantenimiento eléctrico preventivo y correctivo para conservar la operación de instalaciones y equipos.",
    services: [
      "Mantenimiento en baja, media y alta tensión",
      "Mantenimiento a UPS y plantas de emergencia",
      "Suministro e instalación de baterías húmedas y selladas para sistemas de corriente directa",
      "Mantenimiento de sistemas de aire acondicionado",
    ],
  },
  {
    title: "Verificación, auditorías y seguridad",
    icon: "seguridad",
    description:
      "Revisión de condiciones de seguridad y cumplimiento conforme a la normativa aplicable al proyecto.",
    services: [
      "Auditorías de seguridad en instalaciones eléctricas",
      "Verificación de instalaciones y sistemas de iluminación",
      "Revisión de sistemas de puesta a tierra y protección contra descargas atmosféricas",
    ],
  },
];
---

<BaseLayout
  title="Servicios eléctricos"
  description={`Ingeniería, construcción, pruebas y mantenimiento de instalaciones eléctricas para empresas. Conoce los servicios eléctricos de ${brand.name}.`}
>
  <Header slot="header" />

  <main>
    <section class="bg-dark py-16 text-white sm:py-20">
      <div class="mx-auto grid max-w-site grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)] lg:items-center lg:gap-16">
        <div>
          <p class="text-topper font-bold uppercase tracking-widest text-accent">
            Servicios para empresas
          </p>
          <h1 class="mt-3 max-w-4xl font-heading text-h1 font-bold leading-tight text-white">
            Ingeniería eléctrica para proyectos e instalaciones
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/75">
            Acompañamiento técnico en instalaciones eléctricas, desde la
            ingeniería y construcción hasta las pruebas y el mantenimiento.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {[
              "Baja tensión",
              "Media tensión",
              "Alta tensión",
              "Eficiencia energética",
            ].map((scope) => (
              <span class="rounded-md border border-white/20 px-3 py-1.5 text-sm text-white/80">
                {scope}
              </span>
            ))}
          </div>
          <a
            href="/contact"
            class="mt-8 inline-flex min-h-12 items-center rounded-md bg-accent px-7 py-3 font-bold text-dark transition-opacity hover:opacity-90"
          >
            Solicitar asesoría eléctrica
          </a>
        </div>

        <aside class="border-l-2 border-accent/60 pl-6 sm:pl-8">
          <p class="text-topper font-bold uppercase tracking-widest text-accent">
            Cobertura del servicio
          </p>
          <ol class="mt-4 divide-y divide-white/15">
            {[
              "Ingeniería y asesoría",
              "Construcción e instalación",
              "Pruebas y puesta en servicio",
              "Mantenimiento y verificación",
            ].map((step, index) => (
              <li class="flex items-center gap-4 py-4">
                <span class="font-heading text-2xl font-bold text-accent/80">
                  0{index + 1}
                </span>
                <span class="font-semibold text-white">{step}</span>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </section>

    <section class="py-section">
      <div class="mx-auto max-w-site px-4 sm:px-6">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <span class="text-topper font-bold uppercase tracking-widest text-accent">
            Alcance de servicio
          </span>
          <h2 class="mt-2 font-heading text-h2 font-bold text-text">
            Acompañamiento eléctrico según las necesidades del proyecto
          </h2>
          <p class="mt-4 leading-relaxed text-text-muted">
            Desde la definición técnica y la cotización hasta la ejecución,
            revisión y mantenimiento, el alcance se establece de acuerdo con las
            características de cada instalación.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {areas.map((area) => (
            <article class="rounded-lg border border-border bg-background p-5 shadow-sm sm:p-6">
              <div class="flex items-start gap-4">
                <div class="flex size-11 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary">
                  <Icon name={area.icon} class="size-5" />
                </div>
                <div>
                  <h3 class="font-heading text-h3 font-bold text-text">
                    {area.title}
                  </h3>
                  <p class="mt-2 leading-relaxed text-text-muted">
                    {area.description}
                  </p>
                </div>
              </div>
              <ul class="mt-5 space-y-2 border-t border-border pt-4" role="list">
                {area.services.map((service) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" />
                    <span>{service}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-surface py-section">
      <div class="mx-auto max-w-site px-4 sm:px-6">
        <div class="mx-auto max-w-4xl rounded-lg border border-border bg-background p-6 sm:p-8">
          <span class="text-topper font-bold uppercase tracking-widest text-accent">
            Marco de referencia
          </span>
          <h2 class="mt-2 font-heading text-h2 font-bold text-text">
            Normativa relacionada con los servicios
          </h2>
          <p class="mt-3 leading-relaxed text-text-muted">
            Según el tipo de instalación y el alcance del proyecto, los servicios
            pueden involucrar las siguientes Normas Oficiales Mexicanas. Consulta
            su ficha en el Catálogo Mexicano de Normas:
          </p>

          <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2" role="list">
            {[
              {
                code: "NOM-001-SEDE-2012",
                name: "Instalaciones eléctricas (utilización)",
                url: "https://platiica.economia.gob.mx/normalizacion/nom-001-sede-2012/",
              },
              {
                code: "NOM-022-STPS-2015",
                name: "Electricidad estática en los centros de trabajo",
                url: "https://platiica.economia.gob.mx/normalizacion/nom-022-stps-2015/",
              },
              {
                code: "NOM-025-STPS-2008",
                name: "Condiciones de iluminación en los centros de trabajo",
                url: "https://platiica.economia.gob.mx/normalizacion/nom-025-stps-2008/",
              },
              {
                code: "NOM-029-STPS-2011",
                name: "Mantenimiento de instalaciones eléctricas en centros de trabajo",
                url: "https://platiica.economia.gob.mx/normalizacion/nom-029-stps-2011/",
              },
            ].map((standard) => (
              <li>
                <a
                  href={standard.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block rounded-md border border-border p-4 transition-colors hover:border-primary/40 hover:bg-surface"
                >
                  <span class="font-semibold text-primary">{standard.code}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-text-muted">
                    {standard.name}
                  </span>
                  <span class="mt-2 inline-block text-xs font-semibold text-primary">
                    Consultar ficha oficial
                  </span>
                </a>
              </li>
            ))}
          </ul>

          <p class="mt-6 border-t border-border pt-5 text-sm leading-relaxed text-text-muted">
            La aplicación de cada norma y cualquier verificación o certificación
            dependen del alcance contratado y de las acreditaciones vigentes del
            personal u organismo responsable. Se confirman durante la evaluación
            del proyecto.
          </p>
        </div>
      </div>
    </section>

    <CTA data={cta} />
  </main>

  <Footer slot="footer" />
</BaseLayout>
