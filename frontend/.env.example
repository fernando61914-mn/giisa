# Variables de entorno usadas por el sitio y su Pages Function.
# En Cloudflare Pages configura las variables equivalentes para cada entorno.

# Clave pública del widget de Cloudflare Turnstile (necesaria durante el build).
PUBLIC_TURNSTILE_SITE_KEY=

# Variables de servidor para frontend/functions/api/contact.js.
TURNSTILE_SECRET_KEY=
PUBLIC_APPS_SCRIPT_URL=
